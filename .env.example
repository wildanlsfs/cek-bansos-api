API_KEY=your-secret-api-key-here-change-this

# AI Provider: "ollama" or "9router"
AI_PROVIDER=ollama

# ─── Ollama (when AI_PROVIDER=ollama) ────────────────────────────────────────
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=gemma4:e2b

# ─── 9router (when AI_PROVIDER=9router) ──────────────────────────────────────
# API key from your 9router account
NINEROUTER_API_KEY=

# Base URL — change this to your own proxy or self-hosted OpenAI-compatible URL
# Default: https://api.9router.com
NINEROUTER_URL=https://api.9router.com

# Model to use — any vision-capable model supported by your endpoint
# Examples: gemma4:e2b, gpt-4o, qwen2.5vl:3b
NINEROUTER_MODEL=gemma4:e2b
